# Public hoist patterns for Expo + React Native + NativeWind monorepo support.
# pnpm by default keeps transitive deps deep inside .pnpm/ and only flat-symlinks
# direct deps. Metro (the React Native bundler) doesn't know how to traverse the
# .pnpm/ store, so any transitive dep it imports breaks the build.
#
# These patterns force pnpm to put matching packages at the top-level
# node_modules of each project so Metro can resolve them via its standard paths.
#
# Pattern reference: https://pnpm.io/npmrc#public-hoist-pattern

public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=metro
public-hoist-pattern[]=metro-*
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-css-interop
public-hoist-pattern[]=tailwindcss
